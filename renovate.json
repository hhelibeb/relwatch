{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Asia/Shanghai",

  // 与 pnpm 的 minimumReleaseAge（4320 分钟 = 3 天）对齐：Renovate 若升到一个
  // 还不满 3 天的版本，CI 里的 pnpm install 会直接拒绝安装。
  "minimumReleaseAge": "3 days",

  // 新 advisory 出现时立刻开修复 PR。只覆盖直接依赖，传递依赖（如 Cargo.lock
  // 里的 url / rustix）要靠下面的 lockFileMaintenance 兜。
  "osvVulnerabilityAlerts": true,

  // 传递依赖唯一的自动跟随手段：每周一凌晨重跑 cargo update / pnpm update，
  // 锁文件有变化才开 PR。
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 0-6 * * 1"],
    "automerge": true
  },

  // 仓库没有 branch protection，平台级 automerge 会在 CI 跑完前就合入；
  // 改由 Renovate 自己等 checks 全绿再合。
  "platformAutomerge": false,
  "prConcurrentLimit": 5,

  // 安全补丁随时立即开 PR，不受常规更新的定时/审批限制。
  "vulnerabilityAlerts": {
    "enabled": true,
    "dependencyDashboardApproval": false,
    "automerge": false
  },

  "packageRules": [
    // Cargo.toml 里的版本区间只在 semver 不兼容时才动，其余只推 Cargo.lock，
    // 与手改时的 cargo update -p 一致，review 面更小。
    { "matchManagers": ["cargo"], "rangeStrategy": "update-lockfile" },

    // 大版本与 Cargo 0.x 破坏性 minor 留在 Dependency Dashboard，按需手动勾选。
    {
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "matchManagers": ["cargo"],
      "matchCurrentVersion": "/^0\\./",
      "matchUpdateTypes": ["minor"],
      "dependencyDashboardApproval": true
    },
    // specta 三件套精确 pin 了 rc 版本，统一留看板手动升级以防漂移。
    {
      "matchManagers": ["cargo"],
      "matchPackageNames": ["tauri-specta", "specta", "specta-typescript"],
      "groupName": "specta",
      "dependencyDashboardApproval": true
    },

    // 非安全类常规更新按生态与变更级别每周一凌晨分组，避免零散 PR 刷屏挤占名额。
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["patch", "pin", "digest"],
      "groupName": "npm patch dependencies",
      "schedule": ["* 0-6 * * 1"],
      "automerge": true
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor"],
      "groupName": "npm minor dependencies",
      "schedule": ["* 0-6 * * 1"],
      "automerge": false
    },
    {
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["patch", "pin", "digest"],
      "groupName": "cargo patch dependencies",
      "schedule": ["* 0-6 * * 1"],
      "automerge": true
    },
    {
      "matchManagers": ["cargo"],
      "matchCurrentVersion": "!/^0\\./",
      "matchUpdateTypes": ["minor"],
      "groupName": "cargo minor dependencies",
      "schedule": ["* 0-6 * * 1"],
      "automerge": false
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "github-actions",
      "schedule": ["* 0-6 * * 1"],
      "automerge": true
    }
  ]
}
