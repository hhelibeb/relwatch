{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "RelWatch",
  "version": "1.16.0",
  "identifier": "com.relwatch",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build"
  },
  "app": {
    "windows": [
      {
        "title": "RelWatch",
        "width": 750,
        "height": 750,
        "minWidth": 710,
        "minHeight": 450,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data: http://media.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self' ws://localhost:5173; img-src 'self' data: http://media.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "createUpdaterArtifacts": true,
    "windows": {
        "nsis": {
            "template": "nsis/installer.nsi",
            "installMode": "currentUser"
        }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ0ODk1MkQ3ODlGMTUyMUYKUldRZlV2R0oxMUtKMUpvbjNTV3pPcjlhUGptMERVdGRSdlphK3RlSnRINlhvV2hpNW5WdmVqZDkK",
      "endpoints": [
        "https://github.com/hhelibeb/relwatch/releases/latest/download/latest.json"
      ]
    }
  }
}
