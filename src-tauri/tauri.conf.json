{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "RelWatch",
  "version": "1.0.3",
  "identifier": "com.relwatch.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "RelWatch",
        "width": 900,
        "height": 650,
        "minWidth": 700,
        "minHeight": 450,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "windows": {
        "nsis": {
            "template": "nsis/installer.nsi"
        }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
