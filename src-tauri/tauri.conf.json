{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "RelWatch",
  "version": "1.4.1",
  "identifier": "com.relwatch",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "RelWatch",
        "width": 750,
        "height": 750,
        "minWidth": 710,
        "minHeight": 450,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self' ws://localhost:* https://api.github.com https://api.deepseek.com; img-src 'self' data:; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "windows": {
        "nsis": {
            "template": "nsis/installer.nsi"
        }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
